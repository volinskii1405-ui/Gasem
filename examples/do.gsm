; Выражения do: вычисляются при компиляции.
; Строковый результат кладётся в программу, а в приёмник попадает его адрес.
og 0x7C00
b 16

start:
    xor ax - ax
    mov ds - ax
    mov ss - ax
    mov sp - 0x7C00

    do "[msg]" - si          ; si -> "Hello"
    call print
    do "[msg] + 1" - si      ; si -> "Hello1"
    call print
    do "[msg] + [f]" - si    ; si -> "HelloWorld"
    call print

    do "4+4" - ax            ; ax = 8
    add al - '0'             ; цифра '8'
    mov ah - 0x0E
    int 0x10
    jmp $

; print: печатает строку по адресу si (до нулевого байта) и перевод строки
print:
    mov ah - 0x0E
.next:
    nxtb
    chk al - al
    jfz .done
    int 0x10
    jmp .next
.done:
    mov al - 13
    int 0x10
    mov al - 10
    int 0x10
    ret

msg b: "Hello" - 0
f   b: "World" - 0

&& 510-($-$$) b: 0
w: 0xAA55
