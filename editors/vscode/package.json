{
  "name": "gasem",
  "displayName": "Gasem",
  "description": "Подсветка, проверка ошибок при наборе, переход к объявлению, подсказки и сниппеты для языка Gasem",
  "version": "0.2.0",
  "publisher": "gasem",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/volinskii1405-ui/Gasem"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "Formatters"
  ],
  "contributes": {
    "languages": [
      {
        "id": "gasem",
        "aliases": [
          "Gasem",
          "gasem"
        ],
        "extensions": [
          ".gsm"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gasem",
        "scopeName": "source.gasem",
        "path": "./syntaxes/gasem.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "gasem",
        "path": "./snippets/gasem.json"
      }
    ],
    "configuration": {
      "title": "Gasem",
      "properties": {
        "gasem.path": {
          "type": "string",
          "default": "gasem",
          "description": "Путь к программе gasem (Go-версия). Нужна для проверки ошибок, подсказок и команд «Собрать» и «Запустить»."
        },
        "gasem.languageServer": {
          "type": "boolean",
          "default": true,
          "description": "Проверять программу при наборе и давать подсказки (gasem lsp)."
        }
      }
    },
    "commands": [
      {
        "command": "gasem.build",
        "title": "Gasem: Собрать",
        "icon": "$(tools)"
      },
      {
        "command": "gasem.run",
        "title": "Gasem: Собрать и запустить в QEMU",
        "icon": "$(play)"
      },
      {
        "command": "gasem.restart",
        "title": "Gasem: Перезапустить языковой сервер"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "gasem.build",
          "when": "editorLangId == gasem",
          "group": "navigation@1"
        },
        {
          "command": "gasem.run",
          "when": "editorLangId == gasem",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "gasem.build",
          "when": "editorLangId == gasem"
        },
        {
          "command": "gasem.run",
          "when": "editorLangId == gasem"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "gasem",
        "required": [
          "mode",
          "file"
        ],
        "properties": {
          "mode": {
            "type": "string"
          },
          "file": {
            "type": "string"
          }
        }
      }
    ]
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:gasem"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
