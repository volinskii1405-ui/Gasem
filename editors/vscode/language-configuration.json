{
  "comments": { "lineComment": ";" },
  "brackets": [["[", "]"], ["(", ")"]],
  "autoClosingPairs": [
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["[", "]"], ["(", ")"], ["\"", "\""], ["'", "'"]],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:[\\w.]+:\\s*)?(if|elif|else|while|for|repeat)\\b(?!.*\\bend\\b)",
    "decreaseIndentPattern": "^\\s*(elif|else|end|until)\\b"
  },
  "folding": {
    "markers": {
      "start": "^\\s*(if|while|for|repeat)\\b",
      "end": "^\\s*(end|until)\\b"
    }
  },
  "wordPattern": "[A-Za-z_.\\p{L}][\\w.\\p{L}]*|0[xX][0-9A-Fa-f_]+|\\d+"
}
