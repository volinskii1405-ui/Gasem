; =====================================================================
;  Звук: PC-динамик. Канал 2 таймера PIT выдаёт меандр нужной частоты,
;  бит 0 и 1 порта 0x61 подключают его к динамику.
; =====================================================================

b 32
sound_owner d: 0                 ; задача, которая включила звук

; sound_on: звук частотой ebx Гц (меньше 20 — выключить)
sound_on:
    jmp sound_off if ebx < 20
    push eax - edx
    mov eax - 1193182
    xor edx - edx
    div ebx                      ; делитель частоты для канала 2
    push eax
    mov al - 0xB6                ; канал 2, режим 3 (меандр)
    out 0x43 - al
    pop eax
    out 0x42 - al
    mov al - ah
    out 0x42 - al
    in al - 0x61
    or al - 3                    ; подключить динамик к каналу 2
    out 0x61 - al
    pop eax - edx
    ret

; sound_off: выключить звук
sound_off:
    push eax
    in al - 0x61
    and al - 0xFC
    out 0x61 - al
    pop eax
    ret
