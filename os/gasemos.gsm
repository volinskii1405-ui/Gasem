; =====================================================================
;  GasemOS — маленькая 32-битная операционная система на языке Gasem:
;  многозадачность, программы с диска, графика, мышь и звук.
;
;  Сборка:   python3 -m gasem os/gasemos.gsm -o gasemos.img
;  Запуск:   qemu-system-i386 -drive format=raw,file=gasemos.img
;
;  Образ диска: сектор 0 — загрузчик (boot.gsm), дальше — ядро,
;  с сектора FS_START — файловая система GasemFS (fs_image.gsm).
;  Загрузчик кладёт ядро в память сразу за собой (0x7E00), поэтому
;  вся программа собирается одним файлом с одним og.
; =====================================================================

og 0x7C00

; ---- карта памяти и константы
CODE_SEL  = 0x08                 ; селектор сегмента кода в GDT
DATA_SEL  = 0x10                 ; селектор сегмента данных
IDT_ADDR  = 0x1000               ; таблица прерываний (256 * 8 байт)
PD_BASE   = 0x10000              ; каталоги страниц задач (по 4 КБ на задачу)
IDLE_STACK = 0x19000             ; стек задачи простоя
SNAKE_BUF = 0x20000              ; тело змейки (кольцевой буфер)
FS_FAT    = 0x30000              ; таблица блоков файловой системы
FS_DIR    = FS_FAT+512           ; каталог (64 записи по 32 байта)
SECTOR_BUF = 0x31000             ; буфер на один сектор
FILE_BUF  = 0x40000              ; буфер файла (до 32 КБ)
FONT_SAVE = 0x48000              ; шрифт VGA (8 КБ) — на время графики
TEXT_SAVE = 0x4A000              ; текстовый экран (4000 байт) — на время графики
DAC_SAVE  = 0x4B000              ; палитра (768 байт)
STACK_TOP = 0x90000              ; вершина стека задачи 0; ниже — стеки задач 1..7
VGA       = 0xB8000              ; текстовый видеобуфер 80x25
APP_FRAMES = 0x800000            ; с 8 МБ: память программ, по 4 МБ на задачу

include "abi.gsm"                ; общее с программами: адреса, клавиши, вызовы

FS_START  = 64                   ; файловая система начинается с сектора 64

KERNEL_SECTORS = (kernel_end-kernel_start)/512

include "boot.gsm"               ; сектор 0: загрузчик

kernel_start:
include "kernel.gsm"             ; точка входа и инициализация
include "console.gsm"            ; вывод на экран
include "interrupts.gsm"         ; IDT, PIC, таймер, исключения
include "keyboard.gsm"           ; клавиатура PS/2
include "ata.gsm"                ; драйвер диска
include "fs.gsm"                 ; файловая система GasemFS
include "shell.gsm"              ; командная оболочка
include "files.gsm"              ; файловые команды
include "snake.gsm"              ; игра «Змейка»
include "tasks.gsm"              ; задачи и страничная память
include "syscalls.gsm"           ; системные вызовы (int 0x80)
include "programs.gsm"           ; команды run, ps, kill, beep
include "vga.gsm"                ; графика 320x200
include "mouse.gsm"              ; мышь PS/2
include "sound.gsm"              ; PC-динамик

pool                             ; строки из команд вида call puts - "..."
align 512 - 0                    ; ядро занимает целое число секторов
kernel_end:

; ядро не должно залезть на файловую систему (иначе здесь будет ошибка)
b-(FS_START*512-($-$$))
include "fs_image.gsm"           ; начальное содержимое диска
