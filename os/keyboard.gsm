; =====================================================================
;  Клавиатура PS/2: обработчик IRQ 1, перевод скан-кодов в символы,
;  кольцевой буфер нажатий на 256 символов. Коды клавиш — в abi.gsm.
;  Ctrl+C завершает программу, которую ждёт оболочка.
; =====================================================================

b 32
kb_head  b: 0                    ; куда класть следующий символ
kb_tail  b: 0                    ; откуда брать следующий символ
kb_shift b: 0
kb_ctrl  b: 0
kb_caps  b: 0
kb_e0    b: 0                    ; был префикс 0xE0 (расширенная клавиша)
kb_buf   b-256

; Таблицы: скан-код (набор 1) → символ. Ровно 128 байт, остальное — нули.
keymap       b/ 128: 0 - 27 - "1234567890-=" - 8 - 9 - "qwertyuiop[]" - 10 - 0 - "asdfghjkl;'`" - 0 - "\\zxcvbnm,./" - 0 - "*" - 0 - " "
keymap_shift b/ 128: 0 - 27 - "!@#$%^&*()_+" - 8 - 9 - "QWERTYUIOP{}" - 10 - 0 - "ASDFGHJKL:\"~" - 0 - "|ZXCVBNM<>?" - 0 - "*" - 0 - " "

irq1_keyboard:
    pushad
    in al - 0x60                 ; скан-код
    cmp al - 0xE0
    jfe .prefix
    cmp byte [kb_e0] - 0
    jfne .extended
    cmp al - 0x2A                ; левый Shift нажат
    jfe .shift_down
    cmp al - 0x36                ; правый Shift нажат
    jfe .shift_down
    cmp al - 0xAA                ; левый Shift отпущен
    jfe .shift_up
    cmp al - 0xB6                ; правый Shift отпущен
    jfe .shift_up
    cmp al - 0x1D                ; Ctrl нажат
    jfe .ctrl_down
    cmp al - 0x9D                ; Ctrl отпущен
    jfe .ctrl_up
    cmp al - 0x3A                ; Caps Lock
    jfe .caps
    chk al - 0x80                ; отпускание клавиши — пропускаем
    jfnz .eoi
    movzx ebx - al
    mov al - [keymap+ebx]
    cmp byte [kb_shift] - 0
    jfe .case
    mov al - [keymap_shift+ebx]
.case:
    if byte [kb_caps] != 0       ; Caps Lock меняет регистр букв
        mov ah - al
        or ah - 0x20
        if ah >= 'a' and ah <= 'z'
            xor al - 0x20
        end
    end
    if byte [kb_ctrl] != 0       ; Ctrl+буква → 1..26
        mov ah - al
        or ah - 0x20
        if ah >= 'a' and ah <= 'z'
            and al - 0x1F
            if al = 3 and dword [fg_task] != 0
                mov byte [kill_fg] - 1   ; Ctrl+C: завершить программу
                jmp .eoi
            end
        end
    end
.put:
    call kb_push
.eoi:
    mov al - 0x20
    out 0x20 - al
    popad
    iretd
.prefix:
    mov byte [kb_e0] - 1
    jmp .eoi
.shift_down:
    mov byte [kb_shift] - 1
    jmp .eoi
.shift_up:
    mov byte [kb_shift] - 0
    jmp .eoi
.ctrl_down:
    mov byte [kb_ctrl] - 1
    jmp .eoi
.ctrl_up:
    mov byte [kb_ctrl] - 0
    jmp .eoi
.caps:
    xor byte [kb_caps] - 1
    jmp .eoi
.extended:                       ; клавиши с префиксом E0: стрелки, Home, End ...
    mov byte [kb_e0] - 0
    cmp al - 0x1D                ; правый Ctrl
    jfe .ctrl_down
    cmp al - 0x9D
    jfe .ctrl_up
    mov esi - ext_keys
.find:
    mov ah - [esi]
    chk ah - ah
    jfz .eoi                     ; такой клавиши нет в таблице
    cmp al - ah
    jfe .found
    add esi - 2
    jmp .find
.found:
    mov al - [esi+1]
    jmp .put

ext_keys:                        ; скан-код после E0 - код клавиши
    b: 0x48 - KEY_UP - 0x50 - KEY_DOWN - 0x4B - KEY_LEFT - 0x4D - KEY_RIGHT
    b: 0x47 - KEY_HOME - 0x4F - KEY_END - 0x49 - KEY_PGUP - 0x51 - KEY_PGDN
    b: 0x53 - KEY_DEL - 0

; kb_push: положить символ al в буфер (0 — не кладём, полный буфер — теряем)
kb_push:
    push ebx
    chk al - al
    jfz .done
    movzx ebx - byte [kb_head]
    mov [kb_buf+ebx] - al
    inc bl
    cmp bl - [kb_tail]
    jfe .done
    mov [kb_head] - bl
.done:
    pop ebx
    ret

; kb_poll: взять символ без ожидания. ZF=1 — буфер пуст, иначе символ в al.
kb_poll:
    push ebx
    pushfd
    cli
    movzx ebx - byte [kb_tail]
    cmp bl - [kb_head]
    jfe .empty
    mov al - [kb_buf+ebx]
    inc byte [kb_tail]
    popfd
    or ebx - 1                   ; ZF=0: символ есть
    pop ebx
    ret
.empty:
    popfd
    xor ebx - ebx                ; ZF=1
    pop ebx
    ret

; getchar: дождаться нажатия, символ → al. Пока клавиш нет, задача спит
;          и процессор достаётся другим задачам.
getchar:
    call kb_poll
    ret if not zero
    push ecx
    mov ecx - 1
    call sleep
    pop ecx
    jmp getchar
