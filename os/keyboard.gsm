; =====================================================================
;  Клавиатура PS/2: обработчик IRQ 1, перевод скан-кодов в символы,
;  кольцевой буфер нажатий на 256 символов.
; =====================================================================

b 32
KEY_UP    = 0x80                 ; коды стрелок (в буфере, вместо символов)
KEY_DOWN  = 0x81
KEY_LEFT  = 0x82
KEY_RIGHT = 0x83

kb_head  b: 0                    ; куда класть следующий символ
kb_tail  b: 0                    ; откуда брать следующий символ
kb_shift b: 0
kb_caps  b: 0
kb_e0    b: 0                    ; был префикс 0xE0 (расширенная клавиша)
kb_buf   b-256

; Таблицы: скан-код (набор 1) → символ. Ровно 128 байт, остальное — нули.
keymap       b/ 128: 0 - 27 - "1234567890-=" - 8 - 9 - "qwertyuiop[]" - 10 - 0 - "asdfghjkl;'`" - 0 - "\\zxcvbnm,./" - 0 - "*" - 0 - " "
keymap_shift b/ 128: 0 - 27 - "!@#$%^&*()_+" - 8 - 9 - "QWERTYUIOP{}" - 10 - 0 - "ASDFGHJKL:\"~" - 0 - "|ZXCVBNM<>?" - 0 - "*" - 0 - " "

irq1_keyboard:
    pushad
    in al - 0x60                 ; скан-код
    cmp al - 0xE0
    jfe .prefix
    cmp byte [kb_e0] - 0
    jfne .extended
    cmp al - 0x2A                ; левый Shift нажат
    jfe .shift_down
    cmp al - 0x36                ; правый Shift нажат
    jfe .shift_down
    cmp al - 0xAA                ; левый Shift отпущен
    jfe .shift_up
    cmp al - 0xB6                ; правый Shift отпущен
    jfe .shift_up
    cmp al - 0x3A                ; Caps Lock
    jfe .caps
    chk al - 0x80                ; отпускание клавиши — пропускаем
    jfnz .eoi
    movzx ebx - al
    mov al - [keymap+ebx]
    cmp byte [kb_shift] - 0
    jfe .case
    mov al - [keymap_shift+ebx]
.case:
    cmp byte [kb_caps] - 0       ; Caps Lock меняет регистр букв
    jfe .put
    mov ah - al
    or ah - 0x20
    cmp ah - 'a'
    jfb .put
    cmp ah - 'z'
    jfa .put
    xor al - 0x20
.put:
    call kb_push
.eoi:
    mov al - 0x20
    out 0x20 - al
    popad
    iretd
.prefix:
    mov byte [kb_e0] - 1
    jmp .eoi
.shift_down:
    mov byte [kb_shift] - 1
    jmp .eoi
.shift_up:
    mov byte [kb_shift] - 0
    jmp .eoi
.caps:
    xor byte [kb_caps] - 1
    jmp .eoi
.extended:                       ; стрелки: E0 48 / E0 50 / E0 4B / E0 4D
    mov byte [kb_e0] - 0
    mov ah - KEY_UP
    cmp al - 0x48
    jfe .arrow
    mov ah - KEY_DOWN
    cmp al - 0x50
    jfe .arrow
    mov ah - KEY_LEFT
    cmp al - 0x4B
    jfe .arrow
    mov ah - KEY_RIGHT
    cmp al - 0x4D
    jfne .eoi
.arrow:
    mov al - ah
    jmp .put

; kb_push: положить символ al в буфер (0 — не кладём, полный буфер — теряем)
kb_push:
    push ebx
    chk al - al
    jfz .done
    movzx ebx - byte [kb_head]
    mov [kb_buf+ebx] - al
    inc bl
    cmp bl - [kb_tail]
    jfe .done
    mov [kb_head] - bl
.done:
    pop ebx
    ret

; kb_poll: взять символ без ожидания. ZF=1 — буфер пуст, иначе символ в al.
kb_poll:
    push ebx
    cli
    movzx ebx - byte [kb_tail]
    cmp bl - [kb_head]
    jfe .empty
    mov al - [kb_buf+ebx]
    inc byte [kb_tail]
    sti
    or ebx - 1                   ; ZF=0: символ есть
    pop ebx
    ret
.empty:
    sti
    pop ebx
    ret

; getchar: дождаться нажатия, символ → al
getchar:
    call kb_poll
    jfnz .done
    hlt                          ; спим до следующего прерывания
    jmp getchar
.done:
    ret
