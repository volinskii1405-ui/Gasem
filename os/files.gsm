; =====================================================================
;  Файловые команды оболочки: ls, cat, write, append, cp, mv, rm, format.
; =====================================================================

b 32
name_buf  b-24
name_buf2 b-24

; get_name: слово из строки esi → в буфер edi. CF=1 — имени нет или оно длиннее 23
get_name:
    push eax - ecx
    xor ecx - ecx
    while byte [esi] != 0 and byte [esi] != ' ' and ecx < NAME_MAX
        mov al - [esi]
        mov [edi+ecx] - al
        inc esi
        inc ecx
    end
    mov byte [edi+ecx] - 0
    if byte [esi] != 0 and byte [esi] != ' '
        xor ecx - ecx            ; слишком длинное имя — считаем, что его нет
    end
    call skip_spaces
    cmp ecx - 1                  ; CF=1, если ecx = 0
    pop eax - ecx
    ret

; need_fs: CF=1 (и сообщение), если на диске нет файловой системы
need_fs:
    if byte [fs_ready] = 0
        push esi - ebx
        call puts_attr - "No file system on this disk. Type 'format' to create one.\n" - 0x0C
        pop esi - ebx
        stc
        ret
    end
    clc
    ret

; fs_error: напечатать «Error: <eax>» красным
fs_error:
    push esi - ebx
    call puts_attr - "Error: " - 0x0C
    mov esi - eax
    call puts_attr
    call newline
    pop esi - ebx
    ret

; not_found: «File not found: <name_buf>»
not_found:
    push esi - ebx
    call puts_attr - "File not found: " - 0x0C
    mov esi - name_buf
    call puts_attr
    call newline
    pop esi - ebx
    ret

; usage: напечатать строку esi и выйти из команды
usage:
    jmp puts

; append_text: дописать строку esi и перевод строки в FILE_BUF+ecx, ecx += длина
append_text:
    push eax - esi
    while byte [esi] != 0
        mov al - [esi]
        mov [FILE_BUF+ecx] - al
        inc esi
        inc ecx
    end
    mov byte [FILE_BUF+ecx] - 10
    inc ecx
    pop eax - esi
    ret

; save_report: сохранить FILE_BUF (ecx байт) в name_buf и сообщить результат
save_report:
    push esi
    mov esi - name_buf
    call fs_save
    if carry
        call fs_error
    else
        call puts - "Saved "
        mov eax - ecx
        call print_dec
        call puts - " bytes to "
        mov esi - name_buf
        call puts
        call newline
    end
    pop esi
    ret

; ---- ls
cmd_ls:
    call need_fs
    ret if carry
    pushad
    xor ebx - ebx                ; файлов
    xor edx - edx                ; байт
    mov esi - FS_DIR
    for edi - 0 - FS_ENTRIES
        if byte [esi] != 0
            push esi
            call puts - "  "
            pop esi
            mov bl - 0x0F        ; имя — ярко-белым
            call puts_attr
            mov bl - 0
            mov eax - 26
            call tab_to
            mov eax - [esi+DIR_SIZE]
            mov ecx - 7
            call print_dec_w
            push esi
            call puts - " bytes\n"
            pop esi
            inc bh               ; bh — счётчик файлов (bl занят цветом)
            add edx - [esi+DIR_SIZE]
        end
        add esi - 32
    end
    movzx eax - bh
    call print_dec
    call puts - " file(s), "
    mov eax - edx
    call print_dec
    call puts - " bytes used, "
    call fs_free_blocks
    let eax - "eax / 2"          ; блоки по 512 байт → КБ
    call print_dec
    call puts - " KB free\n"
    popad
    ret

; ---- cat <файл>
cmd_cat:
    call need_fs
    ret if carry
    mov edi - name_buf
    call get_name
    mov esi - use_cat
    jfc usage
    mov esi - name_buf
    call fs_find
    jfc not_found
    call fs_load
    mov eax - err_io
    jfc fs_error
    mov edx - ecx
    for ecx - 0 - edx
        mov al - [FILE_BUF+ecx]
        call putc
    end
    if edx != 0 and byte [FILE_BUF+edx-1] != 10
        call newline             ; файл без перевода строки в конце
    end
    ret

; ---- write <файл> <текст>
cmd_write:
    call need_fs
    ret if carry
    mov edi - name_buf
    call get_name
    push esi
    mov esi - use_write
    jfc .usage
    pop esi
    xor ecx - ecx
    if byte [esi] != 0           ; без текста — пустой файл
        call append_text
    end
    jmp save_report
.usage:
    pop eax
    jmp usage

; ---- append <файл> <текст>
cmd_append:
    call need_fs
    ret if carry
    mov edi - name_buf
    call get_name
    push esi
    mov esi - use_append
    jfc .usage
    mov esi - name_buf
    xor ecx - ecx
    call fs_find
    if not carry                 ; файл есть — сначала читаем его
        call fs_load
        if carry
            pop esi
            mov eax - err_io
            jmp fs_error
        end
    end
    pop esi
    call append_text
    jmp save_report
.usage:
    pop eax
    jmp usage

; ---- cp <откуда> <куда>
cmd_cp:
    call need_fs
    ret if carry
    mov edi - name_buf2          ; esi — аргументы, не портим его до второго имени
    call get_name
    jfc .usage
    mov edi - name_buf
    call get_name
    jfc .usage
    mov esi - name_buf2          ; источник
    call fs_find
    if carry
        mov esi - name_buf2      ; сообщаем имя источника
        mov edi - name_buf
        call copy_name
        jmp not_found
    end
    call fs_load
    mov eax - err_io
    jfc fs_error
    jmp save_report              ; сохраняем под именем name_buf
.usage:
    mov esi - use_cp
    jmp usage

; copy_name: скопировать имя esi в буфер edi
copy_name:
    pushad
    mov ecx - 24
    cld
    rep movsb
    popad
    ret

; ---- mv <старое> <новое>
cmd_mv:
    call need_fs
    ret if carry
    mov edi - name_buf
    call get_name
    jfc .usage
    mov edi - name_buf2
    call get_name
    jfc .usage
    mov esi - name_buf2
    call fs_find
    if not carry
        mov eax - err_exists
        jmp fs_error
    end
    mov esi - name_buf
    call fs_find
    jfc not_found
    mov esi - name_buf2
    call fs_set_name
    call fs_flush
    jmp puts - "Renamed.\n"
.usage:
    mov esi - use_mv
    jmp usage

; ---- rm <файл>
cmd_rm:
    call need_fs
    ret if carry
    mov edi - name_buf
    call get_name
    mov esi - use_rm
    jfc usage
    mov esi - name_buf
    call fs_find
    jfc not_found
    call fs_delete
    call puts - "Deleted "
    mov esi - name_buf
    call puts
    jmp newline

; ---- format
cmd_format:
    call fs_format
    jmp puts - "Disk formatted: empty GasemFS.\n"

; tab_to: дополнить строку пробелами до столбца eax
tab_to:
    push eax
    while dword [cur_col] < eax
        push eax
        mov al - ' '
        call putc
        pop eax
    end
    pop eax
    ret

; print_dec_w: число eax, выровненное вправо в поле шириной ecx
print_dec_w:
    pushad
    mov esi - eax
    mov edi - 1                  ; сколько цифр
    while eax >= 10
        let eax - "eax / 10"
        inc edi
    end
    mov al - ' '
    while ecx > edi
        call putc
        dec ecx
    end
    mov eax - esi
    call print_dec
    popad
    ret

err_exists    s: "a file with this name already exists"
use_cat       s: "Usage: cat <file>" - 10
use_write     s: "Usage: write <file> <text>" - 10
use_append    s: "Usage: append <file> <text>" - 10
use_cp        s: "Usage: cp <from> <to>" - 10
use_mv        s: "Usage: mv <old> <new>" - 10
use_rm        s: "Usage: rm <file>" - 10
