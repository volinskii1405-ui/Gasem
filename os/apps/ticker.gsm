; =====================================================================
;  Фоновая задача: точка бегает туда-сюда в строке состояния, пока
;  в консоли работает оболочка.
;      ticker &         запустить в фоне (остановить: ps, kill <номер>)
; =====================================================================

include "../sdk.gsm"

POS   = TEXT_VGA+2*36            ; строка 0, столбцы 36..47
WIDTH = 12
DOT   = 0x17FA                   ; · серый на синем
BALL  = 0x1E07                   ; • жёлтый на синем

main:
    xor ecx - ecx                ; где точка
    mov edx - 1                  ; куда движется
    while 1
        for ebx - 0 - WIDTH
            mov word [POS+ebx*2] - DOT
        end
        mov word [POS+ecx*2] - BALL
        add ecx - edx
        neg edx if ecx = 0 or ecx = WIDTH-1
        sleep 7
    end
