; =====================================================================
;  mandel — множество Мандельброта в графике 320x200.
;  Вычисления — в числах с фиксированной точкой: 1.0 = 4096.
;  Любая клавиша — выход (ядро само вернёт текстовый режим).
; =====================================================================

include "../sdk.gsm"

SHIFT = 12                       ; 12 двоичных знаков после запятой
ONE   = 1 << SHIFT
STEP  = 45                       ; шаг между точками: 45/4096 ≈ 0.011
XMIN  = -10240                   ; левый край: -2.5
YMIN  = -4500                    ; верхний край: -1.1
ITER  = 64                       ; больше шагов — точка внутри множества (чёрная)

main:
    graphics
    call make_palette
    mov edx - GFX                ; куда пишем точку
    mov edi - YMIN               ; cy
    for ebx - 0 - GFX_H
        mov esi - XMIN           ; cx
        for ecx - 0 - GFX_W
            call iterate - esi - edi
            xor eax - eax if eax = ITER
            mov [edx] - al
            inc edx
            add esi - STEP
        end
        add edi - STEP
    end
    gtext 8 - 182 - 255 - "Mandelbrot set. Press any key."
    getkey
    ret

; iterate: сколько шагов z = z² + c, пока |z| < 2 (c = esi + i·edi) → eax
proc iterate - esi - edi uses ebx - ecx - edx
    local n - dword
    mov [n] - 0
    xor ebx - ebx                ; zx
    xor ecx - ecx                ; zy
    while dword [n] < ITER
        let signed eax - "ebx*ebx >> SHIFT"     ; zx²
        let signed edx - "ecx*ecx >> SHIFT"     ; zy²
        add edx - eax
        break if signed edx > 4*ONE             ; |z|² > 4 — точка улетела
        sub edx - eax
        sub eax - edx                           ; zx² - zy²
        let signed ecx - "ebx*ecx >> (SHIFT-1)" ; 2·zx·zy
        add ecx - edi
        lea ebx - [eax+esi]
        inc [n]
    end
    return [n]
end

; make_palette: цвета 1..63 — плавный переход по опорным цветам, 255 — белый
proc make_palette uses ebx - ecx - edx - esi - edi
    for ecx - 0 - 63
        mov esi - ecx
        shr esi - 4              ; участок 0..3: между опорными цветами esi и esi+1
        lea esi - [esi+esi*2+stops]
        mov edx - ecx
        and edx - 15             ; положение внутри участка: 0..15
        xor ebx - ebx            ; цвет 0xRRGGBB
        for edi - 0 - 3          ; три канала
            shl ebx - 8
            push ecx
            movzx eax - byte [esi+edi]     ; от этого значения
            movzx ecx - byte [esi+edi+3]   ; к этому
            let signed ecx - "(ecx - eax) * edx / 16 + eax"
            or ebx - ecx
            pop ecx
        end
        lea eax - [ecx+1]
        palette eax - ebx
    end
    palette 255 - 0xFFFFFF
end

stops:                           ; опорные цвета: R, G, B
    b: 0 - 7 - 100
    b: 32 - 107 - 203
    b: 237 - 255 - 255
    b: 255 - 170 - 0
    b: 60 - 10 - 0

pool
