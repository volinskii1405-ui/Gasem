; =====================================================================
;  Прерывания: таблица IDT, исключения процессора, контроллер PIC,
;  системный таймер PIT (100 Гц) — он же переключает задачи.
; =====================================================================

b 32
ticks d: 0                       ; тиков таймера с момента загрузки (по 10 мс)

; idt_init: заполнить IDT и загрузить её
idt_init:
    pushad
    for ecx - 0 - 256            ; все векторы — «пустой» обработчик
        mov eax - int_ignore
        call set_gate
    end
    for ecx - 0 - 32             ; исключения 0..31 — заглушки по 5 байт
        let eax - "ecx*5 + exc_stubs"
        call set_gate
    end
    mov ecx - 0x20               ; IRQ 0 — таймер
    mov eax - irq0_timer
    call set_gate
    mov ecx - 0x21               ; IRQ 1 — клавиатура
    mov eax - irq1_keyboard
    call set_gate
    mov ecx - 0x2C               ; IRQ 12 — мышь
    mov eax - irq12_mouse
    call set_gate
    mov ecx - 0x80               ; системные вызовы программ
    mov eax - syscall
    call set_gate
    mov ecx - 0x81               ; yield: отдать процессор другой задаче
    mov eax - irq_yield
    call set_gate
    lidt [idt_ptr]
    popad
    ret

; set_gate: вектор ecx → обработчик eax (шлюз прерывания, кольцо 0)
set_gate:
    push eax - edi
    lea edi - [IDT_ADDR+ecx*8]
    mov [edi] - ax               ; младшая половина адреса
    mov word [edi+2] - CODE_SEL
    mov word [edi+4] - 0x8E00    ; присутствует, 32-битный шлюз прерывания
    shr eax - 16
    mov [edi+6] - ax             ; старшая половина адреса
    pop eax - edi
    ret

idt_ptr:
    w: 256*8-1
    d: IDT_ADDR

int_ignore:
    iretd

; pic_init: перенести IRQ 0..15 на векторы 0x20..0x2F, разрешить IRQ 0, 1, 2 и 12
pic_init:
    push eax
    mov al - 0x11                ; ICW1: инициализация
    out 0x20 - al
    out 0xA0 - al
    mov al - 0x20                ; ICW2: базовые векторы
    out 0x21 - al
    mov al - 0x28
    out 0xA1 - al
    mov al - 4                   ; ICW3: каскад на IRQ 2
    out 0x21 - al
    mov al - 2
    out 0xA1 - al
    mov al - 1                   ; ICW4: режим 8086
    out 0x21 - al
    out 0xA1 - al
    mov al - 0xF8                ; маска: таймер, клавиатура и каскад (IRQ 2)
    out 0x21 - al
    mov al - 0xEF                ; на ведомом — только мышь (IRQ 12)
    out 0xA1 - al
    pop eax
    ret

; pit_init: таймер на 100 Гц (1193182 / 100 = 11932)
PIT_DIVISOR = 11932

pit_init:
    push eax
    mov al - 0x36                ; канал 0, режим 3
    out 0x43 - al
    mov ax - PIT_DIVISOR
    out 0x40 - al
    mov al - ah
    out 0x40 - al
    pop eax
    ret

; IRQ 0: таймер. Раз в секунду обновляет строку состояния,
;        каждый тик передаёт процессор следующей задаче.
irq0_timer:
    pushad
    inc dword [ticks]
    mov eax - [ticks]
    xor edx - edx
    mov ecx - 100
    div ecx                      ; eax = секунды, edx = остаток
    call status_update if edx = 0
    mov al - 0x20                ; конец прерывания для PIC
    out 0x20 - al
    jmp switch_task

; ---------------------------------------------------------------------
;  Исключения процессора. 32 заглушки по 5 байт: «call exc_common».
;  Номер исключения вычисляется по адресу возврата из call.
; ---------------------------------------------------------------------
exc_stubs:
&& 32 call exc_common

ERROR_CODE_MASK = 0x27D00        ; исключения 8, 10..14, 17 кладут код ошибки

exc_common:
    cli
    pop eax                      ; адрес сразу за заглушкой
    sub eax - exc_stubs
    xor edx - edx
    mov ecx - 5
    div ecx
    dec eax
    mov ebx - eax                ; ebx = номер исключения
    xor ecx - ecx                ; ecx = код ошибки (если есть)
    mov edx - ERROR_CODE_MASK
    bt edx - ebx
    jfnc .no_code
    pop ecx
.no_code:
    pop edx                      ; edx = eip, на котором случилось исключение
    mov eax - [cur_task]
    jmp app_crash if eax != 0 and eax < MAX_TASKS

    mov byte [cur_attr] - 0x4F   ; ошибка в ядре: белый на красном
    call clear_screen
    call cursor_hide
    mov eax - 3
    push ebx
    xor ebx - ebx
    call set_pos
    pop ebx
    call puts - "   *** KERNEL PANIC ***\n\n"
    call puts - "   CPU exception #"
    call exc_describe
    call puts - "\n\n   The system has been halted. Restart the computer.\n"
.halt:
    hlt
    jmp .halt

; app_crash: исключение в программе — завершить её, а система работает дальше
app_crash:
    push ecx
    mov ecx - eax
    call task_kill               ; заодно вернёт текстовый режим
    imul eax - ecx - Task.size
    pop ecx
    call newline if dword [cur_col] != 0
    push ebx
    lea esi - [tasks+eax+Task.name]
    call puts_attr - esi - 0x0C
    call puts_attr - " crashed: exception #" - 0x0C
    pop ebx
    call exc_describe
    call newline
    int 0x81                     ; задачи больше нет — сюда не вернёмся

; exc_describe: «N: название», EIP = edx и код ошибки ecx (если он есть у исключения ebx)
exc_describe:
    mov eax - ebx
    call print_dec
    call puts - ": "
    mov esi - exc_reserved
    cmp ebx - 20
    jfae .named
    mov esi - [exc_names+ebx*4]
.named:
    call puts
    call puts - "\n   EIP = 0x"
    mov eax - edx
    call print_hex32
    mov eax - ERROR_CODE_MASK
    bt eax - ebx
    jfnc .done
    call puts - "   error code = 0x"
    mov eax - ecx
    call print_hex32
.done:
    ret

exc_reserved s: "Reserved"

exc_names:
    d: e00 - e01 - e02 - e03 - e04 - e05 - e06 - e07 - e08 - e09
    d: e10 - e11 - e12 - e13 - e14 - e15 - e16 - e17 - e18 - e19
e00 s: "Divide Error"
e01 s: "Debug"
e02 s: "Non-Maskable Interrupt"
e03 s: "Breakpoint"
e04 s: "Overflow"
e05 s: "BOUND Range Exceeded"
e06 s: "Invalid Opcode"
e07 s: "Device Not Available"
e08 s: "Double Fault"
e09 s: "Coprocessor Segment Overrun"
e10 s: "Invalid TSS"
e11 s: "Segment Not Present"
e12 s: "Stack-Segment Fault"
e13 s: "General Protection Fault"
e14 s: "Page Fault"
e15 s: "Reserved"
e16 s: "x87 Floating-Point Error"
e17 s: "Alignment Check"
e18 s: "Machine Check"
e19 s: "SIMD Floating-Point Exception"
