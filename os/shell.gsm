; =====================================================================
;  Командная оболочка GasemOS.
; =====================================================================

b 32
LINE_MAX = 76
PROMPT_ATTR = 0x0A               ; светло-зелёный

line_buf b-80

shell:
    call puts_attr - "gasem> " - PROMPT_ATTR
    call readline
    call execute
    jmp shell


; readline: прочитать строку с клавиатуры в line_buf (с забоем)
readline:
    pushad
    xor ecx - ecx                ; длина строки
    while 1
        call getchar
        if al = 10
            break
        elif al = 8
            if ecx != 0
                dec ecx
                call putc
            end
        elif al >= ' ' and al <= '~' and ecx < LINE_MAX
            mov [line_buf+ecx] - al
            inc ecx
            call putc
        end                      ; остальное (Tab, Esc, стрелки) — пропуск
    end
    mov byte [line_buf+ecx] - 0
    call putc                    ; перевод строки
    popad
    ret

; execute: найти команду в таблице и выполнить её
execute:
    pushad
    mov esi - line_buf
    call skip_spaces
    cmp byte [esi] - 0
    jfe .done
    mov edx - commands
.next:
    mov edi - [edx]
    chk edi - edi
    jfz .unknown
    call cmd_match
    jfz .found
    add edx - 8
    jmp .next
.found:
    mov esi - ebx                ; esi = аргументы команды
    call [edx+4]
.done:
    popad
    ret
.unknown:
    call try_program             ; программа на диске с таким именем?
    jfnc .done
    mov bl - 0x0C
    push esi
    mov esi - msg_unknown
    call puts_attr
    pop esi
.word:                           ; печатаем первое слово ввода
    nxtb
    chk al - al
    jfz .hint
    cmp al - ' '
    jfe .hint
    call putc
    jmp .word
.hint:
    call puts - "\nType 'help' to see the list of commands.\n"
    popad
    ret

msg_unknown  s: "Unknown command: "

; cmd_match: совпадает ли начало строки esi с командой edi?
;            ZF=1 — да, ebx = начало аргументов. Портит eax.
cmd_match:
    push esi - edi
.cmp:
    mov al - [edi]
    chk al - al
    jfz .end_of_name
    cmp al - [esi]
    jfne .no
    inc esi
    inc edi
    jmp .cmp
.end_of_name:
    mov al - [esi]
    cmp al - ' '
    jfe .yes
    chk al - al
    jfnz .no
.yes:
    call skip_spaces
    mov ebx - esi
    pop esi - edi
    xor eax - eax                ; ZF=1
    ret
.no:
    pop esi - edi
    or eax - 1                   ; ZF=0
    ret

; skip_spaces: пропустить пробелы в строке esi
skip_spaces:
    cmp byte [esi] - ' '
    jfne .done
    inc esi
    jmp skip_spaces
.done:
    ret

; parse_num: десятичное число из строки esi → eax; CF=1, если цифр нет
parse_num:
    push ebx - ecx
    xor eax - eax
    xor ecx - ecx
.digit:
    movzx ebx - byte [esi]
    sub bl - '0'
    cmp bl - 9
    jfa .end
    imul eax - eax - 10
    add eax - ebx
    inc esi
    inc ecx
    jmp .digit
.end:
    cmp ecx - 1                  ; CF=1, если ecx = 0
    pop ebx - ecx
    ret

; ---------------------------------------------------------------------
;  Таблица команд: адрес имени - адрес обработчика
; ---------------------------------------------------------------------
commands:
    d: s_help - cmd_help
    d: s_clear - cmd_clear
    d: s_about - cmd_about
    d: s_echo - cmd_echo
    d: s_calc - cmd_calc
    d: s_color - cmd_color
    d: s_time - cmd_time
    d: s_uptime - cmd_uptime
    d: s_mem - cmd_mem
    d: s_cpu - cmd_cpu
    d: s_snake - snake_game
    d: s_crash - cmd_crash
    d: s_reboot - cmd_reboot
    d: s_shutdown - cmd_shutdown
    d: s_ls - cmd_ls
    d: s_cat - cmd_cat
    d: s_write - cmd_write
    d: s_append - cmd_append
    d: s_cp - cmd_cp
    d: s_mv - cmd_mv
    d: s_rm - cmd_rm
    d: s_format - cmd_format
    d: s_run - cmd_run
    d: s_ps - cmd_ps
    d: s_kill - cmd_kill
    d: s_beep - cmd_beep
    d: 0

s_help     s: "help"
s_clear    s: "clear"
s_about    s: "about"
s_echo     s: "echo"
s_calc     s: "calc"
s_color    s: "color"
s_time     s: "time"
s_uptime   s: "uptime"
s_mem      s: "mem"
s_cpu      s: "cpu"
s_snake    s: "snake"
s_crash    s: "crash"
s_reboot   s: "reboot"
s_shutdown s: "shutdown"
s_ls       s: "ls"
s_cat      s: "cat"
s_write    s: "write"
s_append   s: "append"
s_cp       s: "cp"
s_mv       s: "mv"
s_rm       s: "rm"
s_format   s: "format"
s_run      s: "run"
s_ps       s: "ps"
s_kill     s: "kill"
s_beep     s: "beep"

; ---- help
cmd_help:
    mov esi - help_text
    jmp puts

help_text:
    b: "System:                                Files:" - 10
    b: "  help          this list              ls                    list files" - 10
    b: "  clear         clear the screen       cat <file>            print a file" - 10
    b: "  about         about GasemOS          write <file> <text>   create a file" - 10
    b: "  echo <text>   print a line           append <file> <text>  add a line" - 10
    b: "  calc 6*7      calculator: + - * / %  cp <from> <to>        copy a file" - 10
    b: "  color <1-15>  text color             mv <old> <new>        rename a file" - 10
    b: "  time          date and time (RTC)    rm <file>             delete a file" - 10
    b: "  uptime        time since boot        format                erase the disk" - 10
    b: "  mem           memory size            Programs on the disk:" - 10
    b: "  cpu           processor (CPUID)      hello [name]          first program" - 10
    b: "  snake         play Snake             edit <file>           text editor" - 10
    b: "  beep          PC speaker sound       paint                 draw with a mouse" - 10
    b: "  crash         test the panic screen  mandel                Mandelbrot set" - 10
    b: "  reboot        restart                music                 play a melody" - 10
    b: "  shutdown      power off (ACPI)       ticker                background task" - 10
    b: "                                       ps / kill <id>        list / stop tasks" - 10
    s: "Type a program name to run it. '&' - in the background, Ctrl+C - stop it." - 10

; ---- clear
cmd_clear:
    jmp clear_screen

; ---- about
cmd_about:
    mov bl - 0x0B
    do "[os_name] + ' ' + [os_version]" - esi
    call puts_attr
    call puts - " - a tiny operating system written in Gasem.\n  Kernel size: "
    mov eax - kernel_end-kernel_start
    call print_dec
    call puts - " bytes ("
    mov eax - KERNEL_SECTORS
    call print_dec
    mov esi - about3
    call puts
    ret

about3 b: " disk sectors) + 512-byte boot sector." - 10
       b: "  32-bit protected mode with paging, preemptive multitasking (7 programs)," - 10
       b: "  system calls (int 0x80), PS/2 keyboard and mouse, VGA text and 320x200" - 10
       s: "  graphics, PC speaker, ATA disk with GasemFS, CMOS real-time clock." - 10

; ---- echo
cmd_echo:
    call puts
    jmp newline

; ---- calc: a op b
cmd_calc:
    call parse_num
    jfc .usage
    mov ebx - eax                ; первое число
    call skip_spaces
    mov cl - [esi]               ; операция
    inc esi
    call skip_spaces
    call parse_num
    jfc .usage
    xchg eax - ebx               ; eax = a, ebx = b
    cmp cl - '+'
    jfe .add
    cmp cl - '-'
    jfe .sub
    cmp cl - '*'
    jfe .mul
    cmp cl - '/'
    jfe .div
    cmp cl - '%'
    jfe .div
.usage:
    jmp puts - "Usage: calc 6*7   (operations: + - * / %)\n"
.add:
    add eax - ebx
    jmp .print
.sub:
    sub eax - ebx
    jmp .print
.mul:
    imul eax - ebx
    jmp .print
.div:
    chk ebx - ebx
    jfz .by_zero
    xor edx - edx
    div ebx
    cmp cl - '/'
    jfe .print
    mov eax - edx
.print:
    push eax
    call puts - "= "
    pop eax
    call print_int
    jmp newline
.by_zero:
    jmp puts_attr - "Error: division by zero\n" - 0x0C


; ---- color N
cmd_color:
    call parse_num
    jfc .usage
    chk eax - eax
    jfz .usage
    cmp eax - 15
    jfa .usage
    mov [cur_attr] - al
    jmp puts - "Text color changed.\n"
.usage:
    jmp puts - "Usage: color <1-15>, e.g. 'color 14' for yellow\n"


; ---- time: дата и время из CMOS (в формате BCD)
cmd_time:
    cli
.wait:                           ; ждём, пока часы не обновляются
    mov al - 0x0A
    call cmos_read
    chk al - 0x80
    jfnz .wait
    mov al - 9                   ; год
    call cmos_read
    mov [rtc_buf] - al
    mov al - 8                   ; месяц
    call cmos_read
    mov [rtc_buf+1] - al
    mov al - 7                   ; день
    call cmos_read
    mov [rtc_buf+2] - al
    mov al - 4                   ; часы
    call cmos_read
    mov [rtc_buf+3] - al
    mov al - 2                   ; минуты
    call cmos_read
    mov [rtc_buf+4] - al
    mov al - 0                   ; секунды
    call cmos_read
    mov [rtc_buf+5] - al
    sti
    call puts - "RTC: 20"
    mov al - [rtc_buf]
    call print_hex2
    mov al - '-'
    call putc
    mov al - [rtc_buf+1]
    call print_hex2
    mov al - '-'
    call putc
    mov al - [rtc_buf+2]
    call print_hex2
    mov al - ' '
    call putc
    mov al - [rtc_buf+3]
    call print_hex2
    mov al - ':'
    call putc
    mov al - [rtc_buf+4]
    call print_hex2
    mov al - ':'
    call putc
    mov al - [rtc_buf+5]
    call print_hex2
    jmp puts - " (UTC)\n"

rtc_buf  b-6

; ---- uptime
cmd_uptime:
    call puts - "Up for "
    mov eax - [ticks]
    xor edx - edx
    mov ecx - 100
    div ecx                      ; eax = секунды
    push eax
    xor edx - edx
    mov ecx - 60
    div ecx                      ; eax = минуты, edx = секунды
    call print_dec
    call puts - " min "
    mov eax - edx
    call print_dec
    call puts - " sec (timer ticks: "
    pop eax
    mov eax - [ticks]
    call print_dec
    jmp puts - ")\n"


; ---- mem: объём памяти из CMOS (как его сообщает BIOS)
cmd_mem:
    call mem_size
    call puts - "Memory: "
    call print_dec
    jmp puts - " MB\n"


; ---- cpu: производитель и название процессора (CPUID)
cmd_cpu:
    pushad
    xor eax - eax
    cpuid
    mov [cpu_buf] - ebx
    mov [cpu_buf+4] - edx
    mov [cpu_buf+8] - ecx
    mov byte [cpu_buf+12] - 0
    call puts - "Vendor:   "
    mov esi - cpu_buf
    call puts
    call newline
    mov eax - 0x80000000         ; есть ли строка с названием?
    cpuid
    cmp eax - 0x80000004
    jfb .features
    mov edi - cpu_buf
    mov ebp - 0x80000002
.brand:
    mov eax - ebp
    cpuid
    mov [edi] - eax
    mov [edi+4] - ebx
    mov [edi+8] - ecx
    mov [edi+12] - edx
    add edi - 16
    inc ebp
    cmp ebp - 0x80000004
    jfbe .brand
    mov byte [edi] - 0
    call puts - "Model:    "
    mov esi - cpu_buf
    call skip_spaces
    call puts
    call newline
.features:
    mov eax - 1
    cpuid
    call puts - "Features:"
    mov esi - feature_names
    xor ecx - ecx
.feat:
    mov eax - [esi]              ; номер бита
    cmp eax - 0xFF
    jfe .end
    bt edx - eax
    jfnc .skip
    push esi
    add esi - 4
    call puts
    pop esi
.skip:
    add esi - 12
    jmp .feat
.end:
    call newline
    popad
    ret

cpu_buf    b-52
feature_names:                   ; бит в edx, затем имя (ровно 8 байт)
    d: 0
    b/ 8: " fpu"
    d: 4
    b/ 8: " tsc"
    d: 6
    b/ 8: " pae"
    d: 8
    b/ 8: " cx8"
    d: 15
    b/ 8: " cmov"
    d: 23
    b/ 8: " mmx"
    d: 25
    b/ 8: " sse"
    d: 26
    b/ 8: " sse2"
    d: 0xFF

; ---- crash: деление на ноль — проверка обработчика исключений
cmd_crash:
    call puts - "Dividing by zero...\n"
    xor edx - edx
    xor eax - eax
    div eax
    ret


; ---- reboot: сброс через контроллер клавиатуры
cmd_reboot:
    cli
.wait:
    in al - 0x64
    chk al - 2
    jfnz .wait
    mov al - 0xFE
    out 0x64 - al
.halt:
    hlt
    jmp .halt

; ---- shutdown: выключение через ACPI (порт QEMU)
cmd_shutdown:
    call puts - "Powering off...\n"
    mov ax - 0x2000
    mov dx - 0x604               ; QEMU (новые версии)
    out dx - ax
    mov dx - 0xB004              ; QEMU (старые версии), Bochs
    out dx - ax
    jmp puts - "ACPI power off is not supported on this machine.\n"

