; =====================================================================
;  Интерфейс между ядром GasemOS и программами: адреса, коды клавиш,
;  номера системных вызовов. Подключается и ядром, и программами
;  (через sdk.gsm), поэтому числа нигде не дублируются.
; =====================================================================

APP_BASE  = 0x400000             ; программа загружается сюда (у каждой задачи — свои 4 МБ)
APP_SIZE  = 0x400000
APP_MAGIC = 0x50504147           ; "GAPP" — первые 4 байта программы, затем адрес main

GFX       = 0xA0000              ; видеопамять графического режима: 320x200, байт на точку
GFX_W     = 320
GFX_H     = 200
TEXT_VGA  = 0xB8000              ; текстовый экран 80x25: символ и цвет

; ---- коды клавиш: обычные клавиши дают ASCII (Enter — 10, Backspace — 8,
;      Tab — 9, Esc — 27, Ctrl+буква — 1..26), остальные — коды ниже
KEY_ESC   = 27
KEY_UP    = 0x80
KEY_DOWN  = 0x81
KEY_LEFT  = 0x82
KEY_RIGHT = 0x83
KEY_HOME  = 0x84
KEY_END   = 0x85
KEY_PGUP  = 0x86
KEY_PGDN  = 0x87
KEY_DEL   = 0x88

; ---- системные вызовы: int 0x80, номер в eax, аргументы в ebx, ecx, edx,
;      esi, edi; результат — в eax. Остальные регистры не меняются.
SYS_EXIT    = 0                  ; завершить программу
SYS_PUTC    = 1                  ; bl — символ
SYS_PUTS    = 2                  ; esi — строка с нулём в конце
SYS_PRINTN  = 3                  ; ebx — число со знаком
SYS_GETKEY  = 4                  ; → eax: клавиша (ждёт нажатия)
SYS_POLLKEY = 5                  ; → eax: клавиша или 0, если не нажата
SYS_CLEAR   = 6                  ; очистить экран
SYS_SETPOS  = 7                  ; ebx — строка (1..24), ecx — столбец
SYS_COLOR   = 8                  ; bl — цвет текста (фон*16 + цвет)
SYS_CURSOR  = 9                  ; ebx: 1 — показать курсор, 0 — спрятать
SYS_TICKS   = 10                 ; → eax: тиков с загрузки (100 в секунду)
SYS_SLEEP   = 11                 ; ebx — сколько тиков спать
SYS_RANDOM  = 12                 ; → eax: случайное число
SYS_TASKID  = 13                 ; → eax: номер своей задачи
SYS_READ    = 14                 ; esi — имя, edi — буфер, ecx — его размер → eax: размер файла или -1
SYS_WRITE   = 15                 ; esi — имя, edi — данные, ecx — размер → eax: 0 или -1
SYS_GFX     = 16                 ; ebx: 1 — графика 320x200 (256 цветов), 0 — снова текст
SYS_PIXEL   = 17                 ; ebx — x, ecx — y, edx — цвет
SYS_RECT    = 18                 ; ebx — x, ecx — y, esi — ширина, edi — высота, edx — цвет
SYS_GTEXT   = 19                 ; ebx — x, ecx — y, edx — цвет, esi — строка (шрифт 8x16)
SYS_PALETTE = 20                 ; ebx — номер цвета, ecx — 0xRRGGBB
SYS_MOUSE   = 21                 ; → eax — x (0..319), ebx — y (0..199), ecx — кнопки
SYS_SOUND   = 22                 ; ebx — частота в герцах (0 — тишина)
SYS_YIELD   = 23                 ; отдать процессор другим задачам
SYS_COUNT   = 24

MOUSE_LEFT   = 1                 ; биты кнопок мыши
MOUSE_RIGHT  = 2
MOUSE_MIDDLE = 4
