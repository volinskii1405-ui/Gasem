; =====================================================================
;  Ядро GasemOS: точка входа и инициализация.
;  Сюда загрузчик передаёт управление уже в 32-битном защищённом режиме.
; =====================================================================

b 32
kernel_main:
    call clear_screen
    call status_init
    call idt_init
    call pic_init
    call pit_init
    sti                          ; с этого момента работают таймер и клавиатура
    call fs_init                 ; найти файловую систему на диске

    mov bl - 0x0B                ; голубой
    mov esi - logo
    call puts_attr
    mov esi - welcome
    call puts
    call disk_info
    jmp shell

; disk_info: строка о диске при загрузке
disk_info:
    if byte [fs_ready] = 0
        jmp puts - "   Disk: no file system (type 'format' to create one).\n\n"
    end
    call puts - "   Disk: GasemFS, "
    xor eax - eax                ; сколько файлов
    mov esi - FS_DIR
    for ecx - 0 - FS_ENTRIES
        if byte [esi] != 0
            inc eax
        end
        add esi - 32
    end
    call print_dec
    call puts - " files, "
    call fs_free_blocks
    let eax - "eax / 2"
    call print_dec
    jmp puts - " KB free. Try 'ls' and 'cat readme.txt'.\n\n"


os_name    s: "GasemOS"
os_version s: "0.1"

logo:
    b: 10
    b: "     ____                             ___  ____" - 10
    b: "    / ___| __ _ ___  ___ _ __ ___    / _ \\/ ___|" - 10
    b: "   | |  _ / _` / __|/ _ \\ '_ ` _ \\  | | | \\___ \\" - 10
    b: "   | |_| | (_| \\__ \\  __/ | | | | | | |_| |___) |" - 10
    b: "    \\____|\\__,_|___/\\___|_| |_| |_|  \\___/|____/" - 10
    b: 10 - 0

welcome:
    b: "   A tiny 32-bit operating system written in the Gasem language." - 10
    s: "   Type 'help' to see the list of commands." - 10
